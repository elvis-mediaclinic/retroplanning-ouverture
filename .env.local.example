# Supabase — projet créé sur https://supabase.com/dashboard
# Exécuter les migrations dans l'ordre dans le SQL editor avant de démarrer l'app :
#   supabase/migrations/0001_init.sql
#   supabase/migrations/0002_etapes_template.sql
# Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (secret key) : jamais exposée au client, utilisée uniquement par
# lib/supabase/service.ts pour créer des comptes utilisateurs.
SUPABASE_SECRET_KEY=

# SMTP — pour les notifications par email (relances, rappels d'échéances).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mediaclinic <noreply@mediaclinic.fr>"
